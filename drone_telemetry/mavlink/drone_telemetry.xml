<?xml version="1.0"?>
<!--
  MAVLink dialect for the drone -> ground station link (SiK 433 MHz radio, /dev/telem_radio).
  After editing this file, run scripts/gen_dialect.sh to regenerate drone_telemetry/drone_dialect.py and
  copy the generated file to the ground station: both ends must use the same dialect.
  Custom message IDs use the 45000-45099 range (no overlap with common/ardupilot/development).
-->
<mavlink>
  <include>common.xml</include>
  <version>1</version>
  <dialect>0</dialect>

  <enums>
    <enum name="DRONE_COMPONENT">
      <description>Monitored on-board component.</description>
      <entry value="1" name="DRONE_COMPONENT_LIDAR"><description>Lidar STL-50B2.</description></entry>
      <entry value="2" name="DRONE_COMPONENT_GIMBAL"><description>Skydroid gimbal.</description></entry>
      <entry value="3" name="DRONE_COMPONENT_CAMERA"><description>Skydroid camera (RGB).</description></entry>
      <entry value="4" name="DRONE_COMPONENT_PX4"><description>PX4 over uXRCE-DDS.</description></entry>
      <entry value="5" name="DRONE_COMPONENT_RADIO"><description>On-board SiK 433 radio: rate_hz = downlink bytes/s, state = "BUF xx%" (free transmit buffer, RADIO_STATUS txbuf).</description></entry>
    </enum>
    <enum name="DRONE_COMPONENT_LEVEL">
      <description>Health level, same values as diagnostic_msgs/DiagnosticStatus.</description>
      <entry value="0" name="DRONE_COMPONENT_LEVEL_OK"><description>Ready / operating normally.</description></entry>
      <entry value="1" name="DRONE_COMPONENT_LEVEL_WARN"><description>Running with a problem.</description></entry>
      <entry value="2" name="DRONE_COMPONENT_LEVEL_ERROR"><description>Error, not operating.</description></entry>
      <entry value="3" name="DRONE_COMPONENT_LEVEL_STALE"><description>No data from the node (crashed or not started).</description></entry>
    </enum>
  </enums>

  <messages>
    <message id="45000" name="DRONE_COMPONENT_STATUS">
      <description>Current state and measured rate of one on-board component.</description>
      <field type="uint8_t" name="component_id" enum="DRONE_COMPONENT">Component.</field>
      <field type="uint8_t" name="level" enum="DRONE_COMPONENT_LEVEL">Health level.</field>
      <field type="float" name="rate_hz" units="Hz">Measured rate (0 without data).</field>
      <field type="char[16]" name="state">State as text, e.g. STREAMING, READY, DISCONNECTED.</field>
    </message>
    <message id="45001" name="DRONE_LOCAL_POSE">
      <description>Local position and attitude (PX4 vehicle_odometry over uXRCE-DDS on the Jetson) for the ground station 3D view. PX4 EKF NED frame (origin = EKF initialisation point), PX4 conventions kept; the ground converts to ENU.</description>
      <field type="uint32_t" name="time_boot_ms" units="ms">Sample time (PX4 timestamp_sample).</field>
      <field type="float" name="x" units="m">North position.</field>
      <field type="float" name="y" units="m">East position.</field>
      <field type="float" name="z" units="m">Down position (negative = above the origin).</field>
      <field type="float[4]" name="q">Quaternion w, x, y, z: FRD (body) -&gt; NED.</field>
      <field type="float" name="vx" units="m/s">North velocity.</field>
      <field type="float" name="vy" units="m/s">East velocity.</field>
      <field type="float" name="vz" units="m/s">Down velocity.</field>
      <field type="uint8_t" name="reset_counter">Incremented on an EKF position reset (position jump); the ground clears its trail.</field>
    </message>
    <message id="45003" name="DRONE_GIMBAL_STATE">
      <description>Skydroid gimbal angles from the Jetson (/gimbal_state, skydroid_msgs/GimbalState), as reported by the gimbal, relative to the drone body.</description>
      <field type="float" name="yaw" units="deg">Yaw.</field>
      <field type="float" name="pitch" units="deg">Pitch (negative = looking down).</field>
      <field type="float" name="roll" units="deg">Roll.</field>
      <field type="uint8_t" name="connected">1 = Jetson connected to the gimbal.</field>
      <field type="uint8_t" name="control_mode">0 = MANUAL, 1 = AUTO (GimbalCommand).</field>
    </message>
  </messages>
</mavlink>
